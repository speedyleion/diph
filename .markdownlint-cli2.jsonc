{
  "config": {
    "line-length": {
        // don't mess with code blocks
        "code_blocks": false
    },
    "no-duplicate-heading": {
        // Each release in the changelog has its own "Added", "Fixed", ...
        "siblings_only": true
    }
  },

  "globs": ["**/*.md"],
  "gitignore": true
}
